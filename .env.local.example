# --- Firebase Admin (server-side) ---
# Full service-account JSON on ONE line. Firebase console →
# Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...",...}'

# --- Auth ---
# Single-admin password for the control centre (no email needed).
ADMIN_PASSWORD=

# --- Crypto ---
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Queue (Phase 4) — QStash = durable fan-out in production ---
# If unset, campaigns fall back to a local self-fetch tick loop
# (fine for dev and small sends).
QSTASH_TOKEN=
QSTASH_URL=
# Signing keys — verify QStash callbacks (Upstash console → QStash → keys)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- App ---
# Public base URL — used for unsubscribe links and the QStash callback target.
# Must be publicly reachable in production (e.g. https://unimail.vercel.app).
APP_URL=http://localhost:3000
# Shared secret authenticating /api/jobs/tick when QStash signing isn't set.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
